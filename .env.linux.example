# Linux Toolchain Environment Configuration Template
# Copy to .env.linux or .env.local

# 1. FFmpeg & FFprobe directory (usually system default in PATH, e.g. /usr/bin)
VT_FFMPEG_DIR=/usr/bin

# 2. CUDA library directory (if using NVIDIA GPU with custom CUDA path)
# Example: /usr/local/cuda/lib64
VT_CUDA_DIR=

# 3. Hardware Settings
VT_DEVICE=auto
VT_COMPUTE_TYPE=auto

# 4. Model & Translation
VT_MODEL=large-v3
VT_ENGINE=agent
VT_SRC=en
VT_TGT=zh-CN
