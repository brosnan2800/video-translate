# video-translate - Generic Environment Configuration Template
# Copy this file to .env or .env.local and adjust paths for your system.

# ==============================================================================
# 1. External Toolchain Paths (FFmpeg & CUDA)
# ==============================================================================
# Directory containing ffmpeg and ffprobe executables
# If left empty, system PATH will be used.
VT_FFMPEG_DIR=

# Directory containing CUDA runtime DLLs/libraries (e.g. cublas64_12.dll, cudart64_12.dll)
# On Windows, this directory will be added to PATH and os.add_dll_directory.
VT_CUDA_DIR=

# ==============================================================================
# 2. Whisper Model Cache & Mirrors
# ==============================================================================
# Path to local HuggingFace cache or in-repo model directory (default: ~/.cache/huggingface)
# HF_HOME=~/.cache/huggingface

# HuggingFace mirror endpoint for fast downloads in mainland China
# HF_ENDPOINT=https://hf-mirror.com

# Default model name or local directory (default: large-v3)
VT_MODEL=large-v3

# ==============================================================================
# 3. Hardware & Inference Defaults
# ==============================================================================
# Device: auto (CUDA if available, else cpu) / cpu / cuda
VT_DEVICE=auto

# Compute type: auto (int8_float16 on cuda, int8 on cpu) / int8 / float16 / int8_float16
VT_COMPUTE_TYPE=auto

# Audio transcription chunk length in seconds (default: 240.0)
VT_CHUNK=240.0

# ==============================================================================
# 4. Translation Engine & Network
# ==============================================================================
# Translation engine: agent (default, local task emission) / google (headless HTTP)
VT_ENGINE=agent

# HTTP Proxy for Google Translate / YouTube captions / HuggingFace download
# (SOCKS is NOT supported — see ADR-003)
# VT_PROXY=http://127.0.0.1:7899
#
# Local proxy listener port used by auto-detection (default 7899). Set this when
# your proxy software listens elsewhere (7890/7891/...): otherwise auto-detect
# fails and the run silently falls back to a DIRECT connection.
# VT_PROXY_PORT=7899

# Source and target languages
VT_SRC=en
VT_TGT=zh-CN

# ==============================================================================
# 5. Audio Routing (VAD / Vocal Separation) & Decision Point (T5 / ADR-032)
# ==============================================================================
# These used to be CLI-only flags that silently defaulted to off, so the routing
# decision could never be persisted or audited. They now resolve through the same
# defaults <- .video-translate.toml <- .env <- CLI chain. Leave them commented to
# let the audio profile decide (recommended); an explicit --flag always wins and is
# recorded as origin=explicit in <base>.vt_state.json.

# VAD on: anchors segment boundaries to real silence (kills timestamp drift).
# VT_VAD=true

# Adaptive VAD: per-chunk routing for mixed audio (dialogue + laughter/cheer/BGM).
# VT_ADAPTIVE_VAD=true

# VAD probability threshold (default 0.35, mirrors transcribe.VAD_THRESHOLD).
# Use a lower value such as 0.1 to recall quiet speech on low-level audio.
# VT_VAD_THRESHOLD=0.35

# Run Demucs vocal separation before transcription (strong BGM / soundtracks / MV).
# VT_SEPARATE_VOCALS=false

# Decision-point timeout in SECONDS (default 300 = 5 minutes). After the audio
# profile is computed, the Agent presents the three routing options (translation
# style / VAD strategy / vocal separation) and waits this long for a reply before
# falling back to the profile recommendation. This wait happens in chat on the
# Agent side — the CLI never sleeps on it.
VT_DECISION_TIMEOUT_SECONDS=300

# Merge / sentence-splitting pass (default true).
# VT_MERGE_ENABLED=true
