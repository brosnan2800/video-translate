# Windows Toolchain Environment Configuration Template
# Copy to .env.win or .env.local

# 1. FFmpeg & FFprobe directory (contains ffmpeg.exe, ffprobe.exe)
# Example: C:\ffmpeg\bin or F:\win-pyvideotrans-v3.92\ffmpeg
VT_FFMPEG_DIR=

# 2. CUDA Runtime libraries (contains cublas64_12.dll, cudart64_12.dll)
# Example: C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.4\bin or F:\win-pyvideotrans-v3.92\_internal\torch\lib
VT_CUDA_DIR=

# 3. Model & Inference Settings
VT_MODEL=large-v3
VT_DEVICE=auto
VT_COMPUTE_TYPE=auto

# 4. Engine & Translation
VT_ENGINE=agent
VT_SRC=en
VT_TGT=zh-CN
