# macOS Toolchain Environment Configuration Template
# Copy to .env.mac or .env.local

# 1. FFmpeg & FFprobe directory (usually managed by Homebrew)
# Apple Silicon Homebrew default: /opt/homebrew/bin
# Intel Mac Homebrew default: /usr/local/bin
VT_FFMPEG_DIR=/opt/homebrew/bin

# 2. Hardware Settings
# CTranslate2 uses CPU on macOS (Metal is not supported by faster-whisper backend)
VT_DEVICE=cpu
VT_COMPUTE_TYPE=int8

# 3. Model & Translation
VT_MODEL=large-v3
VT_ENGINE=agent
VT_SRC=en
VT_TGT=zh-CN
