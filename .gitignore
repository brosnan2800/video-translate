# Large binary assets — NOT tracked (machine-shared / regenerable)
videos/
outputs/
.cache/

# Whisper model weights — downloaded from HF Hub at runtime (--model large-v3),
# or dropped into <repo>/models/<name> as optional local override. Regenerable,
# never tracked. See cli.py _model_cached / _setup.
models/

# Portable FFmpeg — auto-downloaded by `video-translate setup --ffmpeg` into
# tools/ffmpeg (regenerable, never tracked). See toolchain.py ensure_ffmpeg.
tools/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# Local project config & environment (may contain machine-specific proxy/paths)
.video-translate.toml
.env
.env.win
.env.mac
.env.linux
.env.local
.env.*.local
*.local.env

# OS
.DS_Store

# Golden test fixtures (regenerated locally from source video)
docs/golden/

# WorkBuddy private data (memory / skills) — never track
.workbuddy/

# CodeBuddy 工程规则集 —— 有意纳入版本控制（2026-09-16 起）：
#   rules/*.mdc  SDD/TDD（S1-S5）· 数据契约（D1-D5）· 依赖（R1-R7）·
#                操作约束（C1-C5）· PowerShell harness（H0-H5）
# 规则集随仓库分发，clone 即生效，不再依赖本机私有目录。
.codebuddy/*
!.codebuddy/rules/

# .codebuddy/plans/ 被上面 .codebuddy/* 一并忽略（无需单独列出）：
# 它是 plan 模式的自动产物（文件名带 hash 后缀、frontmatter 为 todos 清单），
# 属**工具中间产物**，不是项目契约 —— 契约一律走 docs/adr/ + docs/specs/。
